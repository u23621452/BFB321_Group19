# Copy this file to ".env" and fill in your own values.
# The real .env file must NEVER be committed to GitHub.

# development, testing or production
APP_ENV=development

# Change this to any long random text
SECRET_KEY=change-me

# SQLite (default, no install needed):
DATABASE_URL=sqlite:///stockflow.db

# MySQL instead (remove the line above and use this one):
# DATABASE_URL=mysql+pymysql://user:password@localhost/stockflow