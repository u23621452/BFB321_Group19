{
  "openapi": "3.0.3",
  "info": {
    "title": "StockFlow Engine API",
    "version": "1.0.0",
    "description": "REST API for Penbro Kelnick's storeroom: job files with soft reservation, a 7/14 day shortage queue, shop-floor picks and a stock ledger.\n\nLog in with `POST /api/auth/login`; the session cookie is then sent automatically. Admin may use every endpoint. Demo accounts: reception@, storeroom@, operator@, admin@stockflow.test, password `Password123`.\n\nEvery error has the shape `{\"error\": {\"code\", \"message\", \"details\"?}}`."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Inventory"
    },
    {
      "name": "Jobs"
    },
    {
      "name": "Storeroom"
    },
    {
      "name": "Shop floor"
    },
    {
      "name": "Dashboard"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in (sets a session cookie)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Email or password missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Wrong email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out",
        "responses": {
          "200": {
            "description": "Logged out"
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Who am I?",
        "responses": {
          "200": {
            "description": "The current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/inventory": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Stock with reservations, reorder point and status",
        "description": "Roles: reception, storeroom, operator.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ok",
                "low",
                "critical"
              ]
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Matches SKU or description",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryPage"
                }
              }
            }
          },
          "400": {
            "description": "Bad status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Logged in, but this role may not use the endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "List job files",
        "description": "Roles: reception, storeroom, operator.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "reserved",
                "shortage",
                "kitting",
                "issued"
              ]
            }
          },
          {
            "name": "open",
            "in": "query",
            "description": "1 hides jobs that are already issued",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Matches job number, customer or description",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of jobs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobPage"
                }
              }
            }
          },
          "400": {
            "description": "Bad status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Logged in, but this role may not use the endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Open a job file and soft-reserve its stock",
        "description": "Role: reception. The job gets the next job number; status is `reserved`, or `shortage` if stock cannot cover it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewJob"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Logged in, but this role may not use the endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed - `details` names each bad field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_number}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "One job with its BOM lines and shortages",
        "parameters": [
          {
            "name": "job_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "J-2026-0430"
          }
        ],
        "responses": {
          "200": {
            "description": "The job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Logged in, but this role may not use the endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job number",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/queue": {
      "get": {
        "tags": [
          "Storeroom"
        ],
        "summary": "Jobs starting soon, with order-by alerts",
        "description": "Roles: storeroom, reception.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "default": 7
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The queue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Queue"
                }
              }
            }
          },
          "400": {
            "description": "days out of range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Logged in, but this role may not use the endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/picks": {
      "post": {
        "tags": [
          "Shop floor"
        ],
        "summary": "Confirm a pick",
        "description": "Roles: operator, storeroom. Takes stock off the shelf, writes a ledger row and updates the job status.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPick"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pick recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PickResult"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Logged in, but this role may not use the endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "More than the job still needs, more than is on hand, or job already issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed - `details` names each bad field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/requests": {
      "post": {
        "tags": [
          "Shop floor"
        ],
        "summary": "Ask the storeroom for extra material",
        "description": "Roles: operator, storeroom.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Request created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaterialRequest"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Logged in, but this role may not use the endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed - `details` names each bad field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Storeroom"
        ],
        "summary": "List material requests",
        "description": "Role: storeroom.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "done"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestPage"
                }
              }
            }
          },
          "400": {
            "description": "Bad status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Logged in, but this role may not use the endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/kpis": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Numbers for the dashboard tiles",
        "description": "Roles: reception, storeroom, operator.",
        "responses": {
          "200": {
            "description": "The counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Kpis"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Logged in, but this role may not use the endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "integer",
                "example": 422
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Field name -> what is wrong"
              }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "reception",
              "storeroom",
              "operator",
              "admin"
            ]
          }
        }
      },
      "Login": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "reception@stockflow.test"
          },
          "password": {
            "type": "string",
            "example": "Password123"
          }
        }
      },
      "InventoryItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "sku": {
            "type": "string",
            "example": "CBL-10MM"
          },
          "description": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "bin": {
            "type": "string",
            "example": "C-04-02"
          },
          "on_hand": {
            "type": "integer"
          },
          "reserved": {
            "type": "integer",
            "description": "Promised to open jobs but still on the shelf"
          },
          "available": {
            "type": "integer",
            "description": "on_hand - reserved (never below 0)"
          },
          "reorder_point": {
            "type": "number",
            "description": "demand x lead time + safety stock (95% service level)"
          },
          "order_qty": {
            "type": "integer",
            "description": "EOQ rounded to supplier minimum and pack size"
          },
          "lead_time_days": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "low",
              "critical"
            ]
          }
        }
      },
      "Shortage": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "short_by": {
            "type": "number"
          }
        }
      },
      "JobLine": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "qty": {
            "type": "integer"
          },
          "picked_qty": {
            "type": "integer"
          },
          "short_by": {
            "type": "number"
          }
        }
      },
      "JobSummary": {
        "type": "object",
        "properties": {
          "job_number": {
            "type": "string",
            "example": "J-2026-0430"
          },
          "customer": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "days_to_start": {
            "type": "integer"
          },
          "priority": {
            "type": "string",
            "enum": [
              "Normal",
              "Urgent"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "reserved",
              "shortage",
              "kitting",
              "issued"
            ]
          },
          "line_count": {
            "type": "integer"
          }
        }
      },
      "Job": {
        "allOf": [
          {
            "$ref": "#/components/schemas/JobSummary"
          },
          {
            "type": "object",
            "properties": {
              "lines": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/JobLine"
                }
              },
              "shortages": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Shortage"
                }
              }
            }
          }
        ]
      },
      "NewJob": {
        "type": "object",
        "required": [
          "customer",
          "description",
          "start_date",
          "priority",
          "lines"
        ],
        "properties": {
          "customer": {
            "type": "string",
            "example": "Cape Traction Systems"
          },
          "description": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "priority": {
            "type": "string",
            "enum": [
              "Normal",
              "Urgent"
            ]
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sku",
                "qty"
              ],
              "properties": {
                "sku": {
                  "type": "string",
                  "example": "GSKT-EPDM"
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "NewPick": {
        "type": "object",
        "required": [
          "job_number",
          "sku",
          "qty"
        ],
        "properties": {
          "job_number": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "PickResult": {
        "type": "object",
        "properties": {
          "job_number": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "picked": {
            "type": "integer"
          },
          "picked_total": {
            "type": "integer"
          },
          "remaining": {
            "type": "integer"
          },
          "on_hand_after": {
            "type": "integer"
          },
          "job_status": {
            "type": "string",
            "enum": [
              "reserved",
              "shortage",
              "kitting",
              "issued"
            ]
          }
        }
